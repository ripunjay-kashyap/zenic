# ─── Secrets ──────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
.streamlit/secrets.toml

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.eggs/
dist/
build/

# Virtual environments
.venv/
venv/
env/

# ─── Tooling caches ───────────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ─── Data ─────────────────────────────────────────────────────────────────────
# Raw source data is large and re-downloadable, so `data/` is ignored wholesale.
# NOTE: the pattern must be `data/*`, not `data/` — git cannot re-include a file
# whose parent *directory* is ignored, which would break the negations below.
data/*
# These two are read at runtime and must ship in the container image: the BM25
# index is built from the corpus at startup, and the weekly-summary workflow
# reads the tracking file.
!data/bm25_corpus.json
!data/mock_weekly.json

# Local vector store (production uses Qdrant Cloud)
chroma_db/

# ─── Evaluation output ────────────────────────────────────────────────────────
eval_results/*
!eval_results/ragas_latest.json
ragas_results/
*.ragas.json
baseline_*.json
dev_log/

# ─── Development artifacts ────────────────────────────────────────────────────
# Iteration screenshots from browser-driven testing. Curated images that the
# README links to live in assets/ and are tracked.
test-*.png
smoke-*.png
verify-*.png
landing.png
page-*.png
.playwright-mcp/

# Scratch output
tmp_*.txt
scripts/test_output.txt

# One-off provider/SDK probes. The rest of scripts/oneoff/ is tracked — see
# scripts/oneoff/README.md for why.
scripts/oneoff/test_*.py
scripts/oneoff/debug_*.py

# ─── Notebooks ────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ─── Editors & OS ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db

# ─── Assistant / session notes (not for the public repo) ──────────────────────
CLAUDE.md
.claude/
.gemini/
summary.txt
OVERVIEW/
TESTING/

.agents/
.codex/
*.pdf
