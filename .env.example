# Copy to .env and fill in. .env is git-ignored — never commit real credentials.
#
#   cp .env.example .env
#
# In a hosted deployment, inject credentials as runtime secrets.

# ── Required ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Deployment ────────────────────────────────────────────────────────────────
# development → local ChromaDB   |   production → Qdrant Cloud
ENV=development

# ── Vector store — required when ENV=production ───────────────────────────────
# Startup fails fast if ENV=production and either of these is missing.
QDRANT_URL=https://your-cluster-id.region.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
# VECTOR_COLLECTION=zenic_knowledge

# ── Optional — live API fallbacks ─────────────────────────────────────────────
# USDA food search, used only when local retrieval finds nothing relevant.
USDA_API_KEY=your_usda_api_key_here
# Optional key for the standalone OpenFDA research utility; not used by the graph.
# OPENFDA_API_KEY=your_openfda_api_key_here

# ── Optional evaluation ───────────────────────────────────────────────────────
# GOOGLE_API_KEY=your_google_api_key_here

# ── Optional — models (defaults shown) ────────────────────────────────────────
# GROQ_MODEL=openai/gpt-oss-20b
# Larger model for nested meal/workout JSON; independent of chat/routing.
# GROQ_PLAN_MODEL=openai/gpt-oss-120b
# EMBED_MODEL=BAAI/bge-small-en-v1.5
# RERANKER_MODEL=BAAI/bge-reranker-base
# EMBEDDING_DIMENSIONS=384

# ── Optional — retrieval tuning (defaults shown) ──────────────────────────────
# RETRIEVAL_CANDIDATE_POOL=12
# RETRIEVAL_MAX_PER_SOURCE=12
# RETRIEVAL_TOP_K=7
# Set false to skip the query-expansion call; recall may decrease.
# MULTI_QUERY_ENABLED=true
# MULTI_QUERY_COUNT=3

# ── Optional — resilience (defaults shown) ────────────────────────────────────
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=3
# HTTP_TIMEOUT_SECONDS=10
# HTTP_MAX_RETRIES=2
# VECTOR_STORE_TIMEOUT_SECONDS=30

# ── Optional — observability ──────────────────────────────────────────────────
# LOG_LEVEL=INFO
# LOG_FORMAT defaults to text locally and json when ENV=production.
# LOG_FORMAT=text
